# --- Cloudinary (server-side only: never expose the secret to the browser) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: the SDK also reads CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud>
# as an alternative to the three variables above.
#CLOUDINARY_URL=

# --- Cloudinary Upload Widget (safe for the browser: unsigned preset) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- Database ---
# JSON file persistence (./data/db.json) is the current store and needs no
# configuration. DATABASE_URL is reserved for a future external database
# and is not read by the app today.
#DATABASE_URL=
