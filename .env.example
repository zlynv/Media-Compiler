# --- Cloudinary (server-side only: never expose the secret to the browser) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Cloudinary Upload Widget (safe for the browser: unsigned preset) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- Database ---
# JSON file persistence is the default (./data/db.json). Set DATABASE_URL
# when wiring up an external database.
DATABASE_URL=
